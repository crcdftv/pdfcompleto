# =====================================================================
# PDFCompleto - variaveis de ambiente (Ubuntu/Debian)
#
# Copie para /etc/pdfcompleto.env e ajuste:
#   sudo cp deploy/.env.example /etc/pdfcompleto.env
#   sudo nano /etc/pdfcompleto.env
#   sudo chown root:pdfcompleto /etc/pdfcompleto.env
#   sudo chmod 640 /etc/pdfcompleto.env
#
# O install.sh gera esse arquivo sozinho com um SECRET_KEY novo.
# =====================================================================

# --- OBRIGATORIO: segredo das sessoes do Flask ---
# Gere um novo:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Pasta de dados (uploads, ocr_outputs, signed, .flask_session) ---
PDFCOMPLETO_DATA_DIR=/var/lib/pdfcompleto

# --- Tesseract OCR ---
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# --- Paginas processadas em paralelo pelo OCR ---
# Menor = menos memoria RAM usada. Use 1 ou 2 em VPS com 1-2 GB.
OCR_MAX_WORKERS=2

# --- Assinatura digital por token USB ---
# NAO habilite na VPS (o token e Windows-only). O sistema sobe sem isso.
# TOKEN_PIN=
